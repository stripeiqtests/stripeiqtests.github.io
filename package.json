{
  "name": "iq_test_static",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@10.26.2",
  "engines": {
    "node": ">=22.0.0"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/prepare-hosting.mjs",
    "lint": "eslint .",
    "test:security": "node scripts/security-regression.mjs",
    "test:rich-text": "node scripts/rich-text-regression.mjs",
    "test:browser": "playwright test",
    "test:database": "node scripts/test-database.mjs",
    "test:backup": "node scripts/test-backup.mjs",
    "test:edge": "deno test --config supabase/functions/deno.json --allow-env supabase/functions/tests",
    "check:edge": "deno check --config supabase/functions/deno.json supabase/functions/create-checkout/index.ts supabase/functions/verify-payment/index.ts supabase/functions/send-results-email/index.ts supabase/functions/stripe-webhook/index.ts",
    "test:hosting": "node --test scripts/hosting.test.mjs",
    "test:scheduler": "node --test ops/scheduler/worker.test.mjs",
    "bundle:scheduler": "wrangler deploy --config ops/scheduler/wrangler.json --dry-run --outdir node_modules/.tmp/scheduler-bundle",
    "test:scheduler-runtime": "pnpm bundle:scheduler && node scripts/scheduler-runtime.mjs",
    "bundle:edge": "node scripts/bundle-edge.mjs",
    "verify:production-target": "node scripts/assert-production-target.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@stripe/stripe-js": "^8.11.0",
    "@supabase/supabase-js": "2.118.0",
    "dompurify": "3.4.17",
    "lucide-react": "^0.563.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^16.5.0",
    "miniflare": "5.20261019.2-beta",
    "supabase": "2.109.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^7.3.7",
    "wrangler": "4.152.0"
  }
}
