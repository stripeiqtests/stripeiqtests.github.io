[Unit]
Description=Encrypted read-only backup of IQ Tests database and Storage
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 /opt/inner-code-backup/backup.py create --config %d/config.json
LoadCredential=config.json:/etc/inner-code-backup/config.json
LoadCredential=db.pgpass:/etc/inner-code-backup/db.pgpass
LoadCredential=storage-key:/etc/inner-code-backup/storage-key
DynamicUser=yes
StateDirectory=inner-code-backup
StateDirectoryMode=0700
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
RestrictSUIDSGID=yes
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
MemoryMax=256M
CPUQuota=25%
TimeoutStartSec=3600
