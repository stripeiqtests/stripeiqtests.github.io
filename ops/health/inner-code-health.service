[Unit]
Description=Inner Code production availability and database activity check
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 /opt/inner-code-health/healthcheck.py
DynamicUser=yes
StateDirectory=inner-code-health
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
RestrictSUIDSGID=yes
CapabilityBoundingSet=
MemoryMax=64M
CPUQuota=10%
TimeoutStartSec=180
